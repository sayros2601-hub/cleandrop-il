{
  "name": "cleandrop-il",
  "version": "1.0.0",
  "private": true,
  "description": "CleanDrop IL — Doorstep Trash Pickup PWA & Courier App for Israel",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:remote": "wrangler d1 execute cleandrop-il-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute cleandrop-il-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.16.0"
  }
}
